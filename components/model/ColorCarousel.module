/* JAECOO Palembang — Color Carousel */

.carousel {
  position: relative;
  width: 100%;
  user-select: none;
}

/* ─── Vehicle Image ──────────────────────────────────── */

.vehicleImage {
  position: relative;
  width: 100%;
  aspect-ratio: 16/9;
  overflow: hidden;
  transition: opacity 220ms var(--ease-out);
}

@media (max-width: 767px) {
  .vehicleImage {
    aspect-ratio: 4/3;
  }
}

.transitioning {
  opacity: 0;
}

.vehicleImg {
  object-fit: cover;
}

.vehiclePlaceholder {
  width: 100%;
  height: 100%;
  aspect-ratio: unset !important;
}

/* ─── Controls Overlay ──────────────────────────────── */

.controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-8) var(--space-5) var(--space-8);
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.72) 0%,
    rgba(0,0,0,0.3) 60%,
    transparent 100%
  );
}

@media (min-width: 768px) {
  .controls {
    gap: var(--space-5);
    padding: var(--space-12) var(--space-8) var(--space-10);
  }
}

/* ─── Color Name ─────────────────────────────────────── */

.colorName {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--color-white);
  transition: opacity 220ms var(--ease-out);
}

@media (min-width: 768px) {
  .colorName {
    font-size: var(--text-md);
  }
}

.nameTransitioning {
  opacity: 0;
}

/* ─── Swatches ──────────────────────────────────────── */

.swatches {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
  justify-content: center;
}

.swatch {
  width: 20px;
  height: 20px;
  border-radius: var(--radius-full);
  border: 2px solid transparent;
  cursor: pointer;
  transition:
    transform 200ms var(--ease-out),
    border-color 200ms var(--ease-out),
    box-shadow 200ms var(--ease-out);
  flex-shrink: 0;
}

.swatch:hover {
  transform: scale(1.15);
}

.swatchActive {
  border-color: var(--color-white);
  transform: scale(1.2);
  box-shadow: 0 0 0 2px rgba(255,255,255,0.4);
}

@media (min-width: 768px) {
  .swatch {
    width: 24px;
    height: 24px;
  }
}

/* ─── Arrow Navigation ──────────────────────────────── */

.arrows {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.arrow {
  font-size: var(--text-lg);
  color: rgba(255,255,255,0.72);
  cursor: pointer;
  background: none;
  border: none;
  padding: var(--space-2) var(--space-3);
  transition: color 150ms, opacity 150ms;
  line-height: 1;
}

.arrow:hover {
  color: var(--color-white);
}

.arrowCount {
  font-size: var(--text-xs);
  color: rgba(255,255,255,0.5);
  letter-spacing: var(--tracking-wider);
  font-weight: var(--weight-medium);
  min-width: 40px;
  text-align: center;
}
